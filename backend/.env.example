# --- General ---
APP_NAME=Health Explained API
API_VERSION=v1
ENV=development
PORT=8000
LOG_LEVEL=INFO

# --- Frontend / CORS ---
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=

# --- Database (single shared connection for every module) ---
# SQLite (default, zero setup):
DATABASE_URL=REPLACE_WITH_YOUR_VALUE
# Postgres (production):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/health_explained

# --- Auth / JWT ---
# Generate strong random values, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_WITH_YOUR_VALUE
REFRESH_SECRET_KEY=REPLACE_WITH_YOUR_VALUE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Storage paths ---
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
LOG_DIR=./logs
MODELS_DIR=./models

# --- Upload constraints ---
MAX_FILE_SIZE_MB=25
MAX_PDF_PAGES=30

# --- OCR (PaddleOCR) ---
OCR_LANGUAGE=en
OCR_USE_ANGLE_CLS=True
OCR_USE_GPU=False
OCR_MIN_CONFIDENCE=0.50
# Engines tried in order; rapidocr is an offline fallback if PaddleOCR can't start.
OCR_ENGINE_ORDER=paddleocr,rapidocr
# Load OCR weights at server start instead of inside the first upload request.
OCR_PRELOAD_ON_STARTUP=True
# Keep False: True hides real OCR failures behind fake placeholder text.
OCR_ALLOW_STUB_ENGINE=False

# --- NLP (BioClinicalBERT, falls back to regex-only mode automatically) ---
NLP_MODEL_NAME=emilyalsentzer/Bio_ClinicalBERT
NLP_MAX_INPUT_CHARS=4000

# --- Pipeline ---
REVIEW_CONFIDENCE_THRESHOLD=0.70

# --- Translation ---
# Supported languages (en, ta, kn, te, hi) are defined in
# app/services/translation_service.py and are not env-configurable.

# --- Chatbot: LLM providers ---
# Put the keys on ONE line each, no quotes, no spaces. Restart the backend after editing.
# MODELS: llama-3.3-70b-versatile (Groq, shut down 2026-08-16) and gemini-2.0-flash (Gemini,
# shut down 2026-06-01) are RETIRED -- if your .env still has them, change/remove these lines.
# Fallback models are tried automatically if the primary is rejected.
GROQ_API_KEY=REPLACE_WITH_YOUR_VALUE
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b
GEMINI_API_KEY=REPLACE_WITH_YOUR_VALUE
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-3.8-flash
LLM_TIMEOUT_SECONDS=45
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# --- Chatbot: retrieval (Pinecone vector DB over the ingested healthcare KB) ---
PINECONE_API_KEY=REPLACE_WITH_YOUR_VALUE
PINECONE_INDEX=infosys-healthcare-ai-assistant
PINECONE_NAMESPACE=default
CHATBOT_EMBEDDING_MODEL=BAAI/bge-m3
CHATBOT_TOP_K=5
# Keep False: True replaces real provider errors with a canned "[STUB RESPONSE]" answer.
CHATBOT_ALLOW_STUB_ENGINE=False

# --- Chatbot: voice ---
VOICE_MAX_AUDIO_MB=15
