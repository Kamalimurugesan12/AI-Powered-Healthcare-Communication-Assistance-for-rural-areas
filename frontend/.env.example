VITE_API_BASE_URL=http://localhost:8000/api/v1

# Google OAuth (Google Identity Services). Must be the SAME client ID as the
# backend's GOOGLE_CLIENT_ID (backend/.env) — the frontend gets an ID token
# from Google, and the backend verifies it was issued for this client ID.
# Create one at https://console.cloud.google.com/apis/credentials
# (OAuth client type: "Web application"; add your dev/prod origins under
# "Authorized JavaScript origins", e.g. http://localhost:5173).
VITE_GOOGLE_CLIENT_ID=
